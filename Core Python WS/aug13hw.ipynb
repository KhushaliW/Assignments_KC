   ],
   "source": [
    "name = \"Khushali\"\n",
    "\n",
    "s1 = name[-3:]\n",
    "print(\"S1:\",s1) \n",
    "\n",
    "s2 = name[-8:-3]\n",
    "print(\"S2:\",s2)\n",
    "print(\"S2+i:\",s2+\"i\") \n",
    "\n",
    "s3 = name[:-1]\n",
    "print(\"S3:\",s3)\n",
    "\n",
    "s4 = name[5:-1]\n",
    "print(\"S4:\",s4)\n",
    "\n",
    "s5 = name[-5:5]\n",
    "print(\"S5:\",s5)\n",
    "print(\"S5+e:\",s5+\"e\") "
   ]
  }
